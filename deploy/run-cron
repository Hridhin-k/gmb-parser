#!/bin/sh
# Usage: run-cron <job>. Logs the result to stdout so `docker compose logs cron` shows it.
set -a; . /etc/cron.env; set +a
job="$1"
code=$(curl -sS -o /tmp/cron-out -w '%{http_code}' --max-time 3600 \
  -H "Authorization: Bearer ${CRON_SECRET}" "${APP_URL:-http://app:3000}/api/cron/${job}") || code="curl-failed"
echo "$(date -u +%FT%TZ) cron ${job} -> ${code} $(head -c 300 /tmp/cron-out 2>/dev/null)"
