# Copy these settings into .env.local. Never commit real API keys.
AI_PROVIDER="openai"
AI_MODEL="gpt-6-luna"
OPENAI_API_KEY=""

# Required only for Google routes. No legacy GEMINI_API_KEY setting is used.
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional paired overrides; both empty inherits the default.
AI_EXTRACT_PROVIDER=""
AI_EXTRACT_MODEL=""
AI_REPLY_PROVIDER=""
AI_REPLY_MODEL=""
AI_REPLY_FAST_PROVIDER=""
AI_REPLY_FAST_MODEL=""
AI_INSIGHT_PROVIDER=""
AI_INSIGHT_MODEL=""

# Disabled by default. No automatic provider or model escalation.
AI_FALLBACK_PROVIDER=""
AI_FALLBACK_MODEL=""

# USD per workspace, with per-workspace database overrides taking precedence.
AI_MONTHLY_BUDGET_USD="6"

# Required for models without built-in price estimates. USD per million tokens.
# AI_PRICES_JSON='{"openai:your-model":{"input":0.20,"output":1.00}}'
