# Copy to .env on the server. Never commit the filled-in file.
NEXT_PUBLIC_APP_URL="https://your-domain.com"
AUTH_URL="https://your-domain.com"
AUTH_TRUST_HOST="true"

# Postgres: the owner role runs migrations; the app role is what the server uses.
POSTGRES_OWNER_USER="grm_owner"
POSTGRES_OWNER_PASSWORD=""
POSTGRES_DB="grm"
GRM_APP_PASSWORD="" # must match APP_PASSWORD in DATABASE_URL
DATABASE_MIGRATION_URL="postgres://grm_owner:OWNER_PASSWORD@db:5432/grm"
DATABASE_URL="postgres://grm_app:APP_PASSWORD@db:5432/grm"
DATABASE_POOL_MAX="10"

# openssl rand -base64 32 / openssl rand -hex 32
AUTH_SECRET=""
TOKEN_ENCRYPTION_KEY=""
CRON_SECRET=""
SUPER_ADMIN_EMAILS=""

# Do NOT set AUTH_DEV_* in production.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-domain.com/api/google/callback"

AI_PROVIDER="google"
AI_MODEL="gemini-3.8-flash"
GOOGLE_GENERATIVE_AI_API_KEY=""
AI_MONTHLY_BUDGET_USD=""

RESEND_API_KEY=""
REPORT_FROM_EMAIL=""
PLATFORM_FROM_EMAIL=""
