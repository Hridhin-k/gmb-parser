# Copy settings into .env.local. db:local generates the local database URLs,
# AUTH_SECRET, and local-login token when values are absent or empty.
DATABASE_URL=""
DATABASE_MIGRATION_URL=""
DATABASE_POOL_MAX="10"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Only works with next dev on a loopback origin. Production always disables it.
AUTH_DEV_LOGIN="true"
AUTH_DEV_OPEN_SIGNUP="true"
AUTH_DEV_LOGIN_TOKEN=""
AUTH_DEV_EMAIL="local@grm.test"

# Register BOTH /api/auth/callback/google and /api/google/callback with Google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
# AES-256-GCM key for Business Profile tokens: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""
SUPER_ADMIN_EMAILS=""
CRON_SECRET=""

AI_PROVIDER="google"
AI_MODEL="gemini-3.8-flash"
GOOGLE_GENERATIVE_AI_API_KEY=""
